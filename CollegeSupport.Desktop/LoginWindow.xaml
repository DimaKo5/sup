<Window x:Class="CollegeSupport.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — CollegeSupport" Width="400" Background="#F4F8F9" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AutomationProperties.AutomationId="LoginWindow">
    <StackPanel Margin="16">
        <TextBlock Text="Техническая поддержка колледжа" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginBox" Height="26" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="LoginBox"/>

        <TextBlock Text="Пароль" Margin="0,8,0,0"/>
        <PasswordBox x:Name="PasswordInput" Height="26" Margin="0,2,0,0"
                     AutomationProperties.AutomationId="PasswordInput"/>

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed" AutomationProperties.AutomationId="ErrorText"/>

        <Button x:Name="LoginButton" Content="Войти" IsDefault="True" Height="30" Margin="0,12,0,0"
                Click="LoginButton_Click" AutomationProperties.AutomationId="LoginButton"/>
    </StackPanel>
</Window>
