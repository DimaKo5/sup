<Window x:Class="CollegeSupport.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CollegeSupport.Desktop.Converters"
        Title="CollegeSupport — обращения технической поддержки" Height="620" Width="1150"
        MinHeight="480" MinWidth="960"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        AutomationProperties.AutomationId="MainWindow">
    <Window.Resources>
        <conv:UtcToLocalConverter x:Key="UtcToLocal"/>
    </Window.Resources>

    <DockPanel Background="#F4F8F9">
        <Border DockPanel.Dock="Top" Background="#123C49" Padding="20,14">
            <TextBlock Text="Техническая поддержка колледжа" Foreground="White"
                       FontSize="22" FontWeight="SemiBold"/>
        </Border>
        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="ServerStatusText" Text="Сервер: проверка…"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CountText" AutomationProperties.AutomationId="CountText"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="UserText"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="LogoutButton" Content="Выйти" Padding="12,2"
                        Click="LogoutButton_Click" AutomationProperties.AutomationId="LogoutButton"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Фильтры -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="StatusFilter" Width="190" DisplayMemberPath="Name"
                      AutomationProperties.AutomationId="StatusFilter"/>
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="240" VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown" AutomationProperties.AutomationId="SearchBox"/>
            <Button x:Name="FindButton" Content="Найти" Width="90" Margin="6,0,0,0"
                    Click="FindButton_Click" AutomationProperties.AutomationId="FindButton"/>
        </StackPanel>

        <!-- Действия -->
        <StackPanel x:Name="ActionsPanel" DockPanel.Dock="Right" Width="240" Margin="8,0,8,8">
            <Button x:Name="NewAppealButton" Content="Новое обращение…" Height="30"
                    Click="NewAppealButton_Click" AutomationProperties.AutomationId="NewAppealButton"/>

            <GroupBox Header="Статус выбранного обращения" Margin="0,12,0,0">
                <StackPanel Margin="4">
                    <ComboBox x:Name="NextStatusBox" DisplayMemberPath="Name"
                              AutomationProperties.AutomationId="NextStatusBox"/>
                    <TextBlock Text="Стоимость работ, руб.:" Margin="0,6,0,2"/>
                    <TextBox x:Name="CostBox" AutomationProperties.AutomationId="CostBox"/>
                    <Button x:Name="ChangeStatusButton" Content="Сменить статус" Height="28" Margin="0,6,0,0"
                            Click="ChangeStatusButton_Click" AutomationProperties.AutomationId="ChangeStatusButton"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="TechnicianGroup" Header="Техник" Margin="0,12,0,0">
                <StackPanel Margin="4">
                    <ComboBox x:Name="TechnicianBox" DisplayMemberPath="FullName"
                              AutomationProperties.AutomationId="TechnicianBox"/>
                    <Button x:Name="AssignButton" Content="Назначить техника" Height="28" Margin="0,6,0,0"
                            Click="AssignButton_Click" AutomationProperties.AutomationId="AssignButton"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="ExchangeGroup" Header="Обмен данными" Margin="0,12,0,0">
                <StackPanel Margin="4">
                    <Button x:Name="ImportButton" Content="Импорт сотрудников (CSV)…" Height="28"
                            Click="ImportButton_Click" AutomationProperties.AutomationId="ImportButton"/>
                    <Button x:Name="ExportButton" Content="Выгрузить обращения…" Height="28" Margin="0,6,0,0"
                            Click="ExportButton_Click" AutomationProperties.AutomationId="ExportButton"/>
                </StackPanel>
            </GroupBox>

            <Button x:Name="StatisticsButton" Content="Статистика" Height="30" Margin="0,12,0,0"
                    Click="StatisticsButton_Click" AutomationProperties.AutomationId="StatisticsButton"/>
        </StackPanel>

        <!-- Таблица обращений -->
        <DataGrid x:Name="AppealsGrid" Margin="8,0,0,8" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#EFF6F7"
                  SelectionMode="Single" CanUserAddRows="False"
                  SelectionChanged="AppealsGrid_SelectionChanged"
                  AutomationProperties.AutomationId="AppealsGrid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="45"/>
                <DataGridTextColumn Header="Создано" Width="115"
                    Binding="{Binding CreatedAt, Converter={StaticResource UtcToLocal}, StringFormat=dd.MM.yyyy HH:mm}"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding EmployeePhone}" Width="110"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding Cabinet}" Width="80"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding Equipment}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="150"/>
                <DataGridTextColumn Header="Техник" Binding="{Binding TechnicianName}" Width="*"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost, StringFormat=N2}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
