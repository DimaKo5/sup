<Window x:Class="CollegeSupport.Desktop.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сотрудник" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        AutomationProperties.AutomationId="EmployeeEditWindow">
    <StackPanel Margin="16">
        <TextBlock Text="ФИО"/>
        <TextBox x:Name="FullNameBox" Height="26" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="FullNameBox"/>

        <TextBlock Text="Телефон (например, +7 900 123-45-67)" Margin="0,8,0,0"/>
        <TextBox x:Name="PhoneBox" Height="26" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="PhoneBox"/>

        <TextBlock Text="Электронная почта (необязательно)" Margin="0,8,0,0"/>
        <TextBox x:Name="EmailBox" Height="26" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="EmailBox"/>

        <TextBlock Text="Кабинет" Margin="0,8,0,0"/>
        <TextBox x:Name="CabinetBox" Height="26" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="CabinetBox"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="100" Height="28" IsDefault="True"
                    Click="SaveButton_Click" AutomationProperties.AutomationId="SaveButton"/>
            <Button Content="Отмена" Width="100" Height="28" Margin="8,0,0,0" IsCancel="True" AutomationProperties.AutomationId="CancelButton"/>
        </StackPanel>
    </StackPanel>
</Window>
